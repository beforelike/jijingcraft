{
  "name": "mc-survival-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1 autonomous Minecraft survival bot using mineflayer.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "brain:start": "python -m python_brain.main",
    "export:knowledge": "node src/knowledge/exportKnowledge.js",
    "scenario:berries": "node scripts/berryEscapeScenario.js",
    "scenario:berry-escape": "node scripts/berryEscapeScenario.js",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "minecraft-data": "^3.109.1",
    "mineflayer": "^4.37.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0",
    "vec3": "^0.1.10"
  }
}