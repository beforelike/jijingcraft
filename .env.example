MC_HOST=localhost
MC_PORT=8000
BOT_USERNAME=SurvivalBot
MC_AUTH=offline
# Pin to a Java Edition version that the installed mineflayer release fully supports.
# 1.21.1 is the most recent version where update_health/abilities/server_difficulty/entity metadata are all parsed correctly
# by mineflayer 4.37.x; newer versions (1.21.6+) have incomplete protocol coverage and break health/oxygen readings.
MC_VERSION=1.21.1
CONTROL_INTERVAL_MS=5000
LOG_LEVEL=info
HIDE_PROTOCOL_ERRORS=true
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
TEST_CONTROL_ENABLED=false
AUTO_RECONNECT=true
RECONNECT_MIN_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=60000
SURVIVAL_MEMORY_ENABLED=true
SURVIVAL_MEMORY_FILE=data/survival-memory.json
KNOWN_BLOCK_SEARCH_RADIUS=96
FOOD_STOCK_TARGET=18
LOW_OXYGEN_THRESHOLD=8
NIGHT_SHELTER_RETURN_MAX_DISTANCE=96
FOOD_SEARCH_RADIUS=48
BUILD_SHELTER=true
HOUSE_BLOCK_TARGET=160
WOOL_TARGET=3
PLANT_CROPS=true
CROP_PLOT_TARGET=6
BUILD_ANIMAL_PEN=true
ANIMAL_PEN_BLOCK_TARGET=32
ADVANCED_MATERIAL_TARGET=8
MINE_SEARCH_RADIUS=64
THREAT_RADIUS=20
SAFE_MODE_THREAT_RADIUS=28
IMMEDIATE_THREAT_RADIUS=8
SHELTER_DEFENSE_RADIUS=4
PANIC_RETREAT_MS=3500
AVOID_NIGHT_EXPLORATION=true
ACTION_TIMEOUT_MS=25000
PLACE_BLOCK_TIMEOUT_MS=3000
EXACT_SCAN_RADIUS=5
REGIONAL_SCAN_RADIUS=100
REGIONAL_SCAN_STEP=10

LLM_ENABLED=false
LLM_BASE_URL="https://coding.dashscope.aliyuncs.com/v1"
LLM_API_KEY="your-api-key-here"
LLM_MODEL="qwen3.6-plus"
LLM_TIMEOUT_MS=60000
LLM_PLANNER_INTERVAL_MS=60000
LLM_MAX_TOOL_TURNS=8
LLM_RECORDS_DIR=data/llm/records
LLM_TASK_QUEUE_ENABLED=true
LLM_MAX_QUEUED_TASKS=5
LLM_TASK_QUEUE_MAX_AGE_MS=300000

# Python Smart Brain service. It runs concurrent Python agents and returns behavior tree instances.
PYTHON_BRAIN_ENABLED=false
PYTHON_BRAIN_SERVICE_ENABLED=true
PYTHON_BRAIN_URL=http://127.0.0.1:3001
PYTHON_BRAIN_TIMEOUT_MS=30000
PYTHON_BRAIN_PLANNER_INTERVAL_MS=30000
PYTHON_BRAIN_AUTO_START=false
PYTHON_BRAIN_MANAGED=true
PYTHON_BRAIN_COMMAND=python
PYTHON_BRAIN_ARGS="-m python_brain.main"
BRAIN_HOST=127.0.0.1
BRAIN_PORT=3001
BRAIN_PARALLEL_AGENTS=true
BRAIN_GENERAL_AGENT_ENABLED=true
BRAIN_AGENT_TIMEOUT_MS=45000
BRAIN_MAX_TREES=4